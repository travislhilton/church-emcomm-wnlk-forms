# ---- Extract to temp ---------------------------------------------------
# inside the folder the batch header made and removes when this script ends, however it ends (cancelled, error)
$ExtractRoot = if ($env:CHURCH_TMPDIR) { Join-Path $env:CHURCH_TMPDIR "files" } else { Join-Path $env:TEMP "ChurchEMCOMM_Install_$(Get-Random)" }
New-Item -ItemType Directory -Force $ExtractRoot | Out-Null
foreach ($f in $EmbeddedFiles) {
    $dir  = Join-Path $ExtractRoot $f.Dir
    $dest = Join-Path $dir $f.Name
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force $dir | Out-Null }
    [System.IO.File]::WriteAllBytes($dest, [Convert]::FromBase64String([string]::Concat($f.Chunks)))
}

# ---- Installer logic (install.ps1 with patched RepoRoot) ---------------
$ErrorActionPreference = 'Stop'
$RepoRoot = $ExtractRoot

# Keep the window open on any unhandled error so the user can read it
trap {
    Write-Host ""
    Write-Host "  ----------------------------------------" -ForegroundColor DarkGray
    Write-Host "  ERROR: $_" -ForegroundColor Red
    Write-Host ""
    Write-Host "  Installation did not complete." -ForegroundColor Yellow
    Write-Host "  Screenshot this window and contact your EMCOMM coordinator." -ForegroundColor Yellow
    Write-Host ""
    if (-not $env:CHURCH_EMCOMM_BAT) { Read-Host "  Press Enter to close" }
    exit 1
}

# -- Unblock check ------------------------------------------------------------
# If this script was downloaded from the internet and not unblocked, warn early
try {
    $null = Get-Item $PSCommandPath -Stream Zone.Identifier -ErrorAction Stop
    Write-Host ""
    Write-Host "  NOTE: This file was downloaded from the internet." -ForegroundColor Yellow
    Write-Host "  If the installer fails with a security error, close this window," -ForegroundColor Yellow
    Write-Host "  right-click the file, choose Properties, check Unblock, then run again." -ForegroundColor Yellow
} catch {}

# -- Banner -------------------------------------------------------------------
Clear-Host
Write-Host ""
Write-Host "  Church of Jesus Christ EMCOMM" -ForegroundColor Cyan
Write-Host "  Independent emergency communications volunteer project" -ForegroundColor White
Write-Host "  Installer v1.0" -ForegroundColor Gray
Write-Host ("  " + ("-" * 50)) -ForegroundColor DarkGray
Write-Host ""

# -- Helper functions ---------------------------------------------------------
function Write-Step { param([string]$msg) Write-Host "  --> $msg" -ForegroundColor Cyan }
function Write-OK   { param([string]$msg) Write-Host "  OK  $msg" -ForegroundColor Green }
function Write-Warn { param([string]$msg) Write-Host "  !!  $msg" -ForegroundColor Yellow }
function Write-Err  { param([string]$msg) Write-Host "  XX  $msg" -ForegroundColor Red }
function Write-Info { param([string]$msg) Write-Host "    $msg"   -ForegroundColor Gray }

# -- Test install -------------------------------------------------------------
# testing\test_install.py sets EMCOMM_TEST_ROOT to an empty scratch folder. Documents, the Desktop, the system drive
# and Winlink Express are then folders inside it, so an install can be checked without touching this computer's own
# files. Never set in normal use.
$TestRoot = $env:EMCOMM_TEST_ROOT
function Get-UserFolder([string]$name) {
    if (-not $TestRoot) { return [Environment]::GetFolderPath($name) }
    $p = Join-Path $TestRoot $(if ($name -eq 'MyDocuments') { 'Documents' } else { $name })
    if (-not (Test-Path -LiteralPath $p)) { New-Item -ItemType Directory -Force $p | Out-Null }
    return $p
}
