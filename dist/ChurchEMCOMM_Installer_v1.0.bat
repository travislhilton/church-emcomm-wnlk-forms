# ---- Extract to temp ---------------------------------------------------
# inside the folder the batch header made and removes when this script ends, however it ends (cancelled, error)
$ExtractRoot = if ($env:CHURCH_TMPDIR) { Join-Path $env:CHURCH_TMPDIR "files" } else { Join-Path $env:TEMP "ChurchEMCOMM_Install_$(Get-Random)" }
New-Item -ItemType Directory -Force $ExtractRoot | Out-Null
foreach ($f in $EmbeddedFiles) {
    $dir  = Join-Path $ExtractRoot $f.Dir
    $dest = Join-Path $dir $f.Name
    if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force $dir | Out-Null }
    [System.IO.File]::WriteAllBytes($dest, [Convert]::FromBase64String([string]::Concat($f.Chunks)))
}

# ---- Installer logic (install.ps1 with patched RepoRoot) ---------------
$ErrorActionPreference = 'Stop'
$RepoRoot = $ExtractRoot

# Keep the window open on any unhandled error so the user can read it
trap {
    Write-Host ""
    Write-Host "  ----------------------------------------" -ForegroundColor DarkGray
    Write-Host "  ERROR: $_" -ForegroundColor Red
    Write-Host ""
    Write-Host "  Installation did not complete." -ForegroundColor Yellow
    Write-Host "  Screenshot this window and contact your EMCOMM coordinator." -ForegroundColor Yellow
    Write-Host ""
    if (-not $env:CHURCH_EMCOMM_BAT) { Read-Host "  Press Enter to close" }
    exit 1
}

